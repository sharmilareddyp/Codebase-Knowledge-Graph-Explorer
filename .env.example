# Copy to .env and replace the placeholders. Never commit real secrets.

# Neo4j connection. Match the user and password in docker-compose.yml.
CKG_NEO4J_URI=bolt://localhost:7687
CKG_NEO4J_USER=neo4j
CKG_NEO4J_PASSWORD=please-change-me
CKG_NEO4J_DATABASE=neo4j

# OpenAI is used only for embeddings and grounded answers.
# Leave blank to index and browse the graph without Q&A.
OPENAI_API_KEY=
CKG_OPENAI_API_KEY=
CKG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CKG_OPENAI_EMBEDDING_DIMENSIONS=1536
CKG_OPENAI_CHAT_MODEL=gpt-4o-mini

# Comma-separated absolute directories the HTTP API is allowed to index.
# The CLI does not use this allow-list; it indexes the paths you pass explicitly.
CKG_ALLOWED_ROOTS=

CKG_LOG_LEVEL=INFO
CKG_API_HOST=127.0.0.1
CKG_API_PORT=8000
CKG_VECTOR_MIN_SCORE=0.20
